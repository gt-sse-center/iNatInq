#=============================================================================
# Local Environment Overrides (Copy to .env.local)
# =============================================================================
# This file is gitignored. Copy it to .env.local and fill in your values.
#
# Usage:
#   cp env.local.example .env.local
#   # Edit .env.local with your credentials
#   docker compose --env-file .env.local up -d

# -----------------------------------------------------------------------------
# Qdrant Cloud (Optional - overrides local Qdrant)
# -----------------------------------------------------------------------------
# Get these from https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# -----------------------------------------------------------------------------
# Weaviate Cloud (Optional - overrides local Weaviate)
# -----------------------------------------------------------------------------
# Get these from https://console.weaviate.cloud/
WEAVIATE_URL=https://your-cluster.region.weaviate.cloud
WEAVIATE_API_KEY=your-weaviate-api-key-here
WEAVIATE_GRPC_HOST=grpc-your-cluster.region.weaviate.cloud

# -----------------------------------------------------------------------------
# Ollama External (Optional - overrides local Ollama container)
# -----------------------------------------------------------------------------
# Use an external Ollama instance instead of the local Docker container
# OLLAMA_BASE_URL=http://51.8.104.238:11434
# OLLAMA_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Azure Databricks (moved)
# -----------------------------------------------------------------------------
# Databricks secrets now live in zarf/databricks/dev/.env.local
# See: zarf/databricks/dev/env.local.example

# -----------------------------------------------------------------------------
# Other Overrides (uncomment as needed)
# -----------------------------------------------------------------------------
# VECTOR_DB_PROVIDER=weaviate  # Switch from qdrant to weaviate
# VECTOR_DB_COLLECTION=my-collection

# -----------------------------------------------------------------------------
# Image Embedding (Optional - CLIP/LLaVA)
# -----------------------------------------------------------------------------
# IMAGE_EMBEDDING_PROVIDER=clip
# CLIP_BACKEND=clip
# CLIP_URL=http://<clip-host>:8000
# CLIP_MODEL=ViT-B/32
# CLIP_VECTOR_SIZE=512
# CLIP_BACKEND=hosted_clip
# CLIP_URL=https://<your-endpoint>/score
# CLIP_API_KEY=your-api-key
# CLIP_MODEL=clip-vit-base-patch32
# CLIP_VECTOR_SIZE=512
# CLIP_BACKEND=ollama
# CLIP_URL=http://<ollama-host>:11434
# CLIP_MODEL=llava
# CLIP_TIMEOUT=120
# CLIP_CIRCUIT_BREAKER_THRESHOLD=5
# CLIP_CIRCUIT_BREAKER_TIMEOUT=30
# CLIP_MAX_BATCH_SIZE=8
# IMAGE_BATCH_SIZE=10
# IMAGE_MAX_SIZE_MB=10.0
# IMAGE_TARGET_SIZE=224
