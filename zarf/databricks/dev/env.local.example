#=============================================================================
# Azure Databricks Local Environment Overrides (Copy to .env.local)
# =============================================================================
# This file is gitignored. Copy it to .env.local and fill in values.
#
# Usage:
#   cp env.local.example .env.local
#   # Edit .env.local with your Databricks credentials

# -----------------------------------------------------------------------------
# Azure Databricks (Required for Databricks CLI targets/tests)
# -----------------------------------------------------------------------------
DATABRICKS_HOST=https://your-azure-databricks-url.net
DATABRICKS_TOKEN=your-datbricks-token
DATABRICKS_CLUSTER_ID=your-datbricks-cluster-id
DATABRICKS_JOB_ID=819373966585226
# Dedicated iNaturalist image job id (run_ingest_inat_image.py)
# DATABRICKS_INAT_JOB_ID=377982175316454
# Optional: override cluster id used by make azure-databricks-up/down
# DATABRICKS_CLUSTER_ID=0123-456789-abcdefg
# Optional: override source path inside Databricks workspace
# INATINQ_SRC_DIR=/Workspace/Users/<user>/iNatInq/apps/src

# -----------------------------------------------------------------------------
# Ray tuning (Databricks runtime)
# -----------------------------------------------------------------------------
RAY_NUM_WORKERS=4
RAY_WORKER_CPUS=2

# -----------------------------------------------------------------------------
# Qdrant Cloud (Optional - overrides local Qdrant)
# -----------------------------------------------------------------------------
# QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key

# -----------------------------------------------------------------------------
# Weaviate Cloud (Optional - overrides local Weaviate)
# -----------------------------------------------------------------------------
# WEAVIATE_URL=https://your-cluster.region.weaviate.cloud
# WEAVIATE_API_KEY=your-weaviate-api-key
# WEAVIATE_GRPC_HOST=grpc-your-cluster.region.weaviate.cloud

# -----------------------------------------------------------------------------
# Ollama External (Optional - overrides local Ollama container)
# -----------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://<ollama-host>:11434
# OLLAMA_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Image Embedding (Optional - CLIP/LLaVA)
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER=hosted_clip
# CLIP_URL=http://<clip-host>:8000
# CLIP_MODEL=ViT-B/32
# CLIP_VECTOR_SIZE=512
# CLIP_URL=https://<your-endpoint>/score
# CLIP_API_KEY=your-api-key
# CLIP_MODEL=clip-vit-base-patch32
# CLIP_VECTOR_SIZE=512
# CLIP_URL=http://<ollama-host>:11434
# CLIP_MODEL=llava
# CLIP_TIMEOUT=120
# CLIP_CIRCUIT_BREAKER_THRESHOLD=5
# CLIP_CIRCUIT_BREAKER_TIMEOUT=30
# CLIP_MAX_BATCH_SIZE=8
# IMAGE_BATCH_SIZE=10
# IMAGE_MAX_SIZE_MB=10.0
# IMAGE_TARGET_SIZE=224

# -----------------------------------------------------------------------------
# Vector DB selection (Optional)
# -----------------------------------------------------------------------------
# VECTOR_DB_PROVIDER=qdrant
# VECTOR_DB_COLLECTION=documents

# -----------------------------------------------------------------------------
# iNaturalist Image Ingestion (for run_ingest_inat_image.py / process_inat_images.py)
# -----------------------------------------------------------------------------
# Required: must be a positive integer or job will fail fast.
# INAT_MAX_ROWS=50000
#
# Optional metadata/source controls
# INAT_METADATA_URL=s3://inaturalist-open-data/photos.csv.gz
# INAT_IMAGE_SIZE=medium
# INAT_PHOTO_BASE_URL=https://inaturalist-open-data.s3.amazonaws.com/photos
#
# Optional iNat client resiliency tuning
# INAT_TIMEOUT_S=120
# INAT_CB_FAILURE_THRESHOLD=5
# INAT_CB_RECOVERY_TIMEOUT_S=30

# -----------------------------------------------------------------------------
# S3/MinIO (Object Storage)
# -----------------------------------------------------------------------------
# Connection settings
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=pipeline
# S3_USE_SSL=false
# S3_PATH_STYLE=true
#
# Timeout and retry settings
# S3_TIMEOUT=30
# S3_MAX_RETRIES=3
# S3_RETRY_MIN_WAIT=1.0
# S3_RETRY_MAX_WAIT=10.0
#
# Circuit breaker settings
# S3_CIRCUIT_BREAKER_THRESHOLD=5
# S3_CIRCUIT_BREAKER_TIMEOUT=120
