{
	"info": {
		"_postman_id": "inatinq-pipeline-api-collection",
		"name": "iNatInq Pipeline API",
		"description": "API collection for the iNatInq ML Pipeline service.\n\n## Overview\n\nThis collection provides endpoints for:\n- **Semantic Search**: Query images using vector similarity\n- **Ray Jobs**: Submit and manage Ray processing jobs\n- **Databricks Jobs**: Submit and manage Databricks processing jobs\n- **Cache**: Invalidate semantic cache\n- **Metrics**: Report ingestion job metrics\n\n## Environment Variables\n\nSet these variables in your Postman environment:\n- `base_url`: API base URL (default: `http://localhost:8000`)\n- `collection`: Vector DB collection name (default: `documents`)\n- `s3_prefix`: S3 prefix for processing (default: `inputs/`)\n- `run_id`: Databricks run ID (saved automatically)\n- `job_id`: Ray job ID (saved automatically)\n\n## Getting Started\n\n1. Start the services: `make up`\n2. Import this collection into Postman\n3. Run \"Health Check\" to verify connectivity\n4. Try \"Search Images\" or submit a job",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "collection",
			"value": "documents",
			"type": "string"
		},
		{
			"key": "s3_prefix",
			"value": "inputs/",
			"type": "string"
		},
		{
			"key": "job_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "run_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/healthz",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"healthz"
							]
						},
						"description": "Liveness and readiness probe endpoint.\n\nReturns `{\"status\": \"ok\"}` if the service is running.\n\nNote: Does not check dependencies (MinIO, CLIP, Qdrant, etc.)"
					},
					"response": [
						{
							"name": "Healthy",
							"originalRequest": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}/healthz",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"healthz"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"body": "{\n    \"status\": \"ok\"\n}"
						}
					]
				}
			]
		},
		{
			"name": "Vector Store",
			"item": [
				{
					"name": "Search Images (Text to Image)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/search/images?q=machine learning pipeline&limit=10&provider=qdrant",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"search",
								"images"
							],
							"query": [
								{
									"key": "q",
									"value": "machine learning pipeline",
									"description": "Natural language query string (required)"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Maximum results (1-100, default: 10)"
								},
								{
									"key": "provider",
									"value": "qdrant",
									"description": "Vector DB provider (e.g. qdrant)"
								},
								{
									"key": "collection",
									"value": "{{collection}}",
									"description": "Collection name (optional)",
									"disabled": true
								},
								{
									"key": "model",
									"value": "google/siglip-so400m-patch14-384",
									"description": "Override embedding model name (optional, e.g. google/siglip-so400m-patch14-384)",
									"disabled": true
								}
							]
						},
						"description": "Perform semantic search over images using text queries.\n\n1. Generates text embedding for query via CLIP/Infinity\n2. Searches Qdrant image collections for similar image vectors\n3. Returns ranked image results with similarity scores and S3 URIs"
					},
					"response": [
						{
							"name": "Search Results",
							"originalRequest": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}/search/images?q=machine learning&limit=5&provider=qdrant",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"search",
										"images"
									],
									"query": [
										{
											"key": "q",
											"value": "machine learning"
										},
										{
											"key": "limit",
											"value": "5"
										},
										{
											"key": "provider",
											"value": "qdrant"
										}
									]
								}
							},
							"status": "OK",
							"code": 200,
							"body": "{\n    \"query\": \"machine learning\",\n    \"model\": \"ViT-B/32\",\n    \"collection\": \"documents\",\n    \"provider\": \"qdrant\",\n    \"results\": [\n        {\n            \"id\": \"d790dd2c-99eb-4901-b9c9-538b58318fe3\",\n            \"score\": 0.9234,\n            \"s3_key\": \"images/ml-sample-001.jpg\",\n            \"s3_uri\": \"s3://pipeline/images/ml-sample-001.jpg\",\n            \"format\": \"jpeg\",\n            \"width\": 1920,\n            \"height\": 1080,\n            \"thumbnail_key\": \"thumbnails/ml-sample-001.jpg\"\n        }\n    ],\n    \"total\": 1\n}"
						}
					]
				}
			]
		},
		{
			"name": "Ray Jobs",
			"item": [
				{
					"name": "Submit Ray Image Job",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 202) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('job_id', jsonData.job_id);",
									"    console.log('Saved job_id:', jsonData.job_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"s3_bucket\": \"pipeline\",\n    \"s3_prefix\": \"{{s3_prefix}}\",\n    \"collection\": \"{{collection}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/ray/jobs/images",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"ray",
								"jobs",
								"images"
							]
						},
						"description": "Submit a Ray job to process S3 images into vector embeddings.\n\nThe job will:\n1. List image objects from S3/MinIO at the specified bucket and prefix\n2. Generate embeddings via CLIP/Infinity\n3. Store vectors in Qdrant image collections\n\n**Note**: Saves `job_id` to collection variables for subsequent requests."
					},
					"response": [
						{
							"name": "Job Submitted",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"s3_bucket\": \"pipeline\",\n    \"s3_prefix\": \"inputs/\",\n    \"collection\": \"documents\"\n}"
								},
								"url": {
									"raw": "{{base_url}}/ray/jobs/images",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"ray",
										"jobs",
										"images"
									]
								}
							},
							"status": "Accepted",
							"code": 202,
							"body": "{\n    \"job_id\": \"raysubmit_abc123xyz\",\n    \"status\": \"submitted\",\n    \"namespace\": \"ml-system\",\n    \"s3_bucket\": \"pipeline\",\n    \"s3_prefix\": \"inputs/\",\n    \"collection\": \"documents\",\n    \"submitted_at\": \"2026-03-26T15:30:45.123456Z\"\n}"
						}
					]
				},
				{
					"name": "Process DLQ (Ray)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/ray/jobs/process-dlq",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"ray",
								"jobs",
								"process-dlq"
							]
						},
						"description": "Process previously failed image ingestions from the dead letter queue using Ray.\n\nThis endpoint retries images that failed during initial ingestion. Failed images are stored in the DLQ with error metadata for debugging."
					},
					"response": [
						{
							"name": "Job Submitted",
							"status": "Accepted",
							"code": 202,
							"body": "{\n    \"job_id\": \"raysubmit_xyz789\",\n    \"status\": \"submitted\",\n    \"namespace\": \"ml-system\",\n    \"submitted_at\": \"2026-03-26T15:30:45.123456Z\"\n}"
						}
					]
				},
				{
					"name": "Get Ray Job Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ray/jobs/{{job_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"ray",
								"jobs",
								"{{job_id}}"
							]
						},
						"description": "Get the status of a Ray job.\n\n**Requires**: `job_id` variable (set automatically by \"Submit Ray Job\")\n\n**Statuses**: PENDING, RUNNING, SUCCEEDED, FAILED, STOPPED"
					},
					"response": [
						{
							"name": "Job Running",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"job_id\": \"raysubmit_abc123xyz\",\n    \"status\": \"RUNNING\",\n    \"message\": null\n}"
						},
						{
							"name": "Job Succeeded",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"job_id\": \"raysubmit_abc123xyz\",\n    \"status\": \"SUCCEEDED\",\n    \"message\": null\n}"
						},
						{
							"name": "Job Failed",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"job_id\": \"raysubmit_abc123xyz\",\n    \"status\": \"FAILED\",\n    \"message\": \"RuntimeError: Connection to embedding service failed\"\n}"
						}
					]
				},
				{
					"name": "Get Ray Job Logs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ray/jobs/{{job_id}}/logs",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"ray",
								"jobs",
								"{{job_id}}",
								"logs"
							]
						},
						"description": "Get logs from a Ray job.\n\n**Requires**: `job_id` variable (set automatically by \"Submit Ray Job\")"
					},
					"response": [
						{
							"name": "Job Logs",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"job_id\": \"raysubmit_abc123xyz\",\n    \"logs\": \"2026-01-14 12:00:00 INFO Processing 1000 documents...\\n2026-01-14 12:05:00 INFO Batch 1/10 complete\\n2026-01-14 12:10:00 INFO Completed successfully.\"\n}"
						}
					]
				},
				{
					"name": "Stop Ray Job",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ray/jobs/{{job_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"ray",
								"jobs",
								"{{job_id}}"
							]
						},
						"description": "Stop a running Ray job.\n\n**Requires**: `job_id` variable (set automatically by \"Submit Ray Job\")"
					},
					"response": [
						{
							"name": "Job Stopped",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"job_id\": \"raysubmit_abc123xyz\",\n    \"status\": \"stopped\"\n}"
						}
					]
				}
			]
		},
